{
  "name": "mobx-example",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test-coverage": "pnpm vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=./tests-junit.xml",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx ./src",
    "lint-junit": "eslint --ext .js,.jsx,.ts,.tsx ./src -f junit > junit.xml"
  },
  "dependencies": {
    "mobx": "^6.16.1",
    "mobx-react-lite": "^3.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "happy-dom": "^21.0.4",
    "typescript": "^4.9.5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=12 <13"
  }
}
